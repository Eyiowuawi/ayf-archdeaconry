# A GitHub personal access token with write ("Contents") access to GITHUB_REPO.
# Fine-grained token scoped to just this one repo is recommended.
GITHUB_TOKEN=

# e.g. "your-username"
GITHUB_OWNER=

# e.g. "parish-tracker"
GITHUB_REPO=

# Branch to read/write the data file on
GITHUB_BRANCH=main

# Path, within the repo, of the JSON file used as the data store
GITHUB_DATA_PATH=data/fill-data.json

# ---- Admin area (/admin) ----
# Password for signing in to the admin area. Use a long, unique one.
ADMIN_PASSWORD=
# Optional: a long random string used to sign the admin session cookie (defaults to ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=
# Local testing only: set to 1 to use the JSON test-data file (.data/cms.json) with `npm start`.
# `npm run dev` uses it automatically. Never set this on Vercel.
CMS_LOCAL_STORE=
